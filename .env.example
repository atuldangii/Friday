# FRIDAY AI Configuration
# Copy this file to .env to configure optional cloud features

# Optional Gemini Cloud AI Key for advanced reasoning & vision
GEMINI_API_KEY=

# Optional OpenAI compatible API (if using alternative LLM providers)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Assistant Defaults
FRIDAY_USER_NAME=Sir
FRIDAY_VOICE_RATE=180
FRIDAY_VOICE_VOLUME=1.0
FRIDAY_WAKE_WORD=hey friday
FRIDAY_ENABLE_CLOUD_AI=false
FRIDAY_ENABLE_VISION=true
